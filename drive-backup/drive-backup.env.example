# cp drive-backup.env.example drive-backup.env (git-ignored). Values: letters, digits and . _ / @ + - only.
# The drive: the bucket Mountain Duck keeps the Cryptomator vault in (S3: IDrive e2, Wasabi, ...)
DRIVE_S3_PROVIDER=IDrive              # rclone's provider name (IDrive, Wasabi, Other, ...)
DRIVE_S3_ENDPOINT=s3.eu-west-4.idrivee2.com
DRIVE_S3_REGION=                      # if the provider needs one
DRIVE_S3_BUCKET=my-drive
DRIVE_S3_PREFIX=                      # optional: only this folder of the bucket
# The backup: a Backblaze B2 bucket with the lifecycle rule "keep prior versions for 30 days"
DRIVE_B2_BUCKET=my-drive-backup
DRIVE_B2_PREFIX=                      # optional: a folder in it
DRIVE_MAX_CHANGE=10                   # the guard: stop when more than this % of the backup's files would change or go
DRIVE_HC_URL=                         # optional heartbeat URL, pinged after each good sync
