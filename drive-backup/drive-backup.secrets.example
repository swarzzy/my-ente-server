# cp drive-backup.secrets.example drive-backup.secrets; chmod 600 drive-backup.secrets (git-ignored).
# install copies the keys into /etc/drive-backup/rclone.conf (600); this file may be deleted afterwards.
DRIVE_S3_ACCESS_KEY=        # the drive bucket, READ ONLY (the devices have their own key)
DRIVE_S3_SECRET_KEY=
DRIVE_B2_KEY_ID=            # the backup bucket: listBuckets, listFiles, readFiles, writeFiles (no deleteFiles)
DRIVE_B2_KEY=
