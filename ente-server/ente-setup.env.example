DOMAIN=ente.example.com     # hostnames api., web., albums. and s3. sit under it
ADMIN_USER=ops
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA... owner@pc"
MODE=production             # or: test (see README, never on a real server)
DATA_DISK=                  # e.g. /dev/vdb; empty = everything on the system disk
LOW_RAM=auto                # auto = yes below 1.5 GB RAM; or yes / no
BOX_HOST=uXXXXX-sub1.your-storagebox.de
BOX_USER=uXXXXX-sub1
BOX_PORT=23                 # 23 for Hetzner; other values only for testing against a local SFTP
# Backup target: sftp = Hetzner Storage Box (default, uses BOX_*), or any S3 bucket (e.g. IDrive e2):
# BACKUP_TARGET=s3
# BACKUP_S3_PROVIDER=IDrive   # rclone provider name: IDrive, Minio, Other, ...
# BACKUP_S3_ENDPOINT=s3.eu-west-4.idrivee2.com
# BACKUP_S3_REGION=eu-west-4
# BACKUP_S3_BUCKET=my-bucket  # access key and secret are asked at the prompt, never stored here
HC_URL=                     # optional healthchecks.io ping URL
FAIL2BAN=yes
SYNCTHING=no
# FORCE_FORMAT=yes          # only to erase a DATA_DISK that already holds data
