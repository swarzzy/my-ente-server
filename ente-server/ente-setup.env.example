DOMAIN=ente.example.com     # hostnames api., web. and albums. sit under it
ADMIN_USER=ops
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA... owner@pc"
SSH_PORT=22                 # sshd port; bootstrap moves sshd, UFW and fail2ban to it (open it in your provider's firewall too)
FAIL2BAN=yes
HC_URL=                     # optional heartbeat URL (healthchecks.io, Better Stack, ...), pinged after each good backup
TG_CHAT_ID=                 # optional Telegram alerts (failed backup, daily check): your chat ID, or a group's (-100...). Token: secrets
RESTORE=no                  # yes = `deploy` restores an existing backup instead of installing fresh
S3_PROXY_HOST=              # optional add-on ente-s3-proxy.sh: e.g. s3.ente.example.com (needs its DNS record) (README: S3 proxy)
CSP_REPORT_ONLY=no          # yes = send a Report-Only Content-Security-Policy on web./albums. (logs violations in the browser console, blocks nothing)

# Photo bucket: any S3-compatible service (IDrive e2, Backblaze B2, Wasabi...). Keys: see ente-setup.secrets.example
S3_PROVIDER=IDrive          # rclone provider name: IDrive, Other, Wasabi, ...
S3_ENDPOINT=s3.eu-west-4.idrivee2.com   # bare hostname, no https://
S3_REGION=eu-west-4
S3_BUCKET=my-ente-photos
# S3_CORS_ORIGINS=https://web.ente.example.com,https://albums.ente.example.com   # default; set on the bucket for web uploads

# Backup bucket: must be a different bucket (ideally a different provider)
BACKUP_S3_PROVIDER=Other    # Other = Backblaze B2; or IDrive, Wasabi, ...
BACKUP_S3_ENDPOINT=s3.us-east-005.backblazeb2.com
BACKUP_S3_REGION=us-east-005
BACKUP_S3_BUCKET=my-ente-backup

# Optional second backup location: Yandex Disk (native API). Empty = off. Token: YANDEX_TOKEN in ente-setup.secrets.
YANDEX_DIR=                 # folder on the Disk, e.g. ente-backup
YANDEX_CLIENT_ID=           # your own Yandex OAuth app (README); secret: YANDEX_CLIENT_SECRET in ente-setup.secrets
RESTORE_FROM=s3             # with RESTORE=yes: s3 (backup bucket) or yandex

# AmneziaWG VPN (`vpn` command). Independent of Ente: needs only bootstrap and this line.
AWG_PORT=                   # UDP port 1024-65535 (pick a random high one, e.g. 27461); open it in your provider's firewall too
