DOMAIN=ente.example.com     # hostnames api., web. and albums. sit under it (s3. too with STORAGE=silo)
ADMIN_USER=ops
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA... owner@pc"
MODE=production             # or: test (see README, never on a real server)
LOW_RAM=auto                # auto = yes below 1.5 GB RAM; or yes / no
FAIL2BAN=yes
SYNCTHING=no
HC_URL=                     # optional healthchecks.io ping URL
RESTORE=no                  # yes = `deploy` restores an existing backup instead of installing fresh

# ---- Photo storage -------------------------------------------------------------------------
# s3   = external S3 bucket (IDrive e2, Backblaze B2, Wasabi...). No Silo, no data disk: right for a small VPS.
# silo = local Silo (MinIO fork) container, optionally on DATA_DISK.
STORAGE=s3
S3_PROVIDER=IDrive          # rclone provider name: IDrive, Other, Wasabi, ...
S3_ENDPOINT=s3.eu-west-4.idrivee2.com   # bare hostname, no https://
S3_REGION=eu-west-4
S3_BUCKET=my-ente-photos
# S3_CORS_ORIGINS=https://web.ente.example.com,https://albums.ente.example.com   # default; set on the bucket for web uploads
# Keys: S3_ACCESS_KEY / S3_SECRET_KEY, see ente-setup.secrets.example

# STORAGE=silo only:
DATA_DISK=                  # e.g. /dev/vdb; empty = everything on the system disk
# FORCE_FORMAT=yes          # only to erase a DATA_DISK that already holds data

# ---- Backup target ---------------------------------------------------------------------------
# sftp = Hetzner Storage Box (uses BOX_*), or s3 = any other S3 bucket (must be a DIFFERENT bucket/provider than the photos)
BACKUP_TARGET=s3
BACKUP_S3_PROVIDER=Other    # rclone provider name: Other (Backblaze B2), IDrive, Minio, ...
BACKUP_S3_ENDPOINT=s3.us-east-005.backblazeb2.com
BACKUP_S3_REGION=us-east-005
BACKUP_S3_BUCKET=my-ente-backup
# Keys: BACKUP_S3_ACCESS_KEY / BACKUP_S3_SECRET_KEY, see ente-setup.secrets.example

BOX_HOST=uXXXXX-sub1.your-storagebox.de   # BACKUP_TARGET=sftp only
BOX_USER=uXXXXX-sub1
BOX_PORT=23                 # 23 for Hetzner; other values only for testing against a local SFTP
