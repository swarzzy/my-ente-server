# cp ente-setup.secrets.example ente-setup.secrets; chmod 600 ente-setup.secrets   (git-ignored)
# Any variable left out is asked for at a prompt. The same names can also be set in the environment.
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_PASSPHRASE=          # encrypts the config backup (museum.yaml, DB dump). Lose it = lose the backup. Keep it in a password manager.
