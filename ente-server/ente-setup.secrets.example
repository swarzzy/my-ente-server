# cp ente-setup.secrets.example ente-setup.secrets; chmod 600 ente-setup.secrets   (git-ignored)
# Any variable left out is asked for at a prompt. The same names can also be set in the environment.
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_PASSPHRASE=          # encrypts the config backup (museum.yaml, DB dump). Lose it = lose the backup. Keep it in a password manager.
# Only with YANDEX_DIR set: the JSON from `rclone authorize "yandex"` (on a PC with a browser), in single quotes, one line.
# Needed only for the first backup-setup; rclone keeps and refreshes it in /root/.config/rclone/rclone.conf.
YANDEX_TOKEN=
# Only with TG_CHAT_ID set: the bot token from @BotFather (123456:ABC...). Kept in /etc/ente-alert.env (600) after backup-setup.
TG_BOT_TOKEN=
